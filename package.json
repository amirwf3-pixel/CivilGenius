
{
  "name": "civilgenius",
  "private": true,
  "version": "20.0.0",
  "type": "module",
  "description": "CivilGenius v20 — RTL Persian civil-engineering design, live market prices, BOQ and document delivery center",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --force",
    "artifacts": "tsx scripts/generate-artifacts.ts",
    "smoke": "tsx --tsconfig tsconfig.smoke.json scripts/smoke.tsx",
    "test:e2e": "tsx --tsconfig tsconfig.app.json scripts/e2e-mount.tsx",
    "test:dxf": "tsx --tsconfig tsconfig.app.json scripts/dxf-audit.tsx"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "katex": "^0.18.7",
    "lucide-react": "^1.44.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}

